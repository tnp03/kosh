"var Component=(()=>{var m=Object.create;var a=Object.defineProperty;var f=Object.getOwnPropertyDescriptor;var _=Object.getOwnPropertyNames;var u=Object.getPrototypeOf,p=Object.prototype.hasOwnProperty;var y=(r,e)=>()=>(e||r((e={exports:{}}).exports,e),e.exports),g=(r,e)=>{for(var s in e)a(r,s,{get:e[s],enumerable:!0})},i=(r,e,s,o)=>{if(e&&typeof e==\"object\"||typeof e==\"function\")for(let l of _(e))!p.call(r,l)&&l!==s&&a(r,l,{get:()=>e[l],enumerable:!(o=f(e,l))||o.enumerable});return r};var x=(r,e,s)=>(s=r!=null?m(u(r)):{},i(e||!r||!r.__esModule?a(s,\"default\",{value:r,enumerable:!0}):s,r)),k=r=>i(a({},\"__esModule\",{value:!0}),r);var t=y((b,d)=>{d.exports=_jsx_runtime});var q={};g(q,{default:()=>c});var n=x(t());function h(r){let e={code:\"code\",h1:\"h1\",h2:\"h2\",h3:\"h3\",li:\"li\",ol:\"ol\",p:\"p\",pre:\"pre\",strong:\"strong\",ul:\"ul\",...r.components};return(0,n.jsxs)(n.Fragment,{children:[(0,n.jsx)(e.h1,{children:\"Transformer\"}),`\n`,(0,n.jsx)(e.p,{children:'The transformer is a neural network architecture introduced in the 2017 paper \"Attention Is All You Need.\" It has become the foundation for virtually all modern large language models and has revolutionized natural language processing.'}),`\n`,(0,n.jsx)(e.h2,{children:\"Key Innovation: Self-Attention\"}),`\n`,(0,n.jsx)(e.p,{children:\"The transformer's core innovation is the self-attention mechanism, which allows the model to weigh the importance of different parts of the input when processing each element:\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-python\",children:`import torch\nimport torch.nn as nn\n\nclass SelfAttention(nn.Module):\n    def __init__(self, embed_size, heads):\n        super().__init__()\n        self.heads = heads\n        self.head_dim = embed_size // heads\n        \n        self.values = nn.Linear(self.head_dim, self.head_dim, bias=False)\n        self.keys = nn.Linear(self.head_dim, self.head_dim, bias=False)\n        self.queries = nn.Linear(self.head_dim, self.head_dim, bias=False)\n        self.fc_out = nn.Linear(heads * self.head_dim, embed_size)\n    \n    def forward(self, values, keys, query, mask):\n        N = query.shape[0]\n        value_len, key_len, query_len = values.shape[1], keys.shape[1], query.shape[1]\n        \n        # Split the embedding into self.heads different pieces\n        values = values.reshape(N, value_len, self.heads, self.head_dim)\n        keys = keys.reshape(N, key_len, self.heads, self.head_dim)\n        query = query.reshape(N, query_len, self.heads, self.head_dim)\n        \n        # Attention scores\n        energy = torch.einsum(\"nqhd,nkhd->nhqk\", [query, keys])\n        \n        if mask is not None:\n            energy = energy.masked_fill(mask == 0, float(\"-1e20\"))\n        \n        attention = torch.softmax(energy / (self.head_dim ** 0.5), dim=3)\n        \n        out = torch.einsum(\"nhqk,nvhd->nqhd\", [attention, values]).reshape(\n            N, query_len, self.heads * self.head_dim\n        )\n        \n        return self.fc_out(out)\n`})}),`\n`,(0,n.jsx)(e.h2,{children:\"Architecture Components\"}),`\n`,(0,n.jsx)(e.h3,{children:\"Encoder\"}),`\n`,(0,n.jsx)(e.p,{children:\"The encoder processes the input sequence:\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-python\",children:`class TransformerEncoder(nn.Module):\n    def __init__(self, embed_size, num_layers, heads, forward_expansion, dropout):\n        super().__init__()\n        self.layers = nn.ModuleList([\n            TransformerBlock(embed_size, heads, forward_expansion, dropout)\n            for _ in range(num_layers)\n        ])\n        self.norm = nn.LayerNorm(embed_size)\n    \n    def forward(self, x, mask):\n        for layer in self.layers:\n            x = layer(x, x, x, mask)\n        return self.norm(x)\n`})}),`\n`,(0,n.jsx)(e.h3,{children:\"Decoder\"}),`\n`,(0,n.jsx)(e.p,{children:\"The decoder generates the output sequence:\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-python\",children:`class TransformerDecoder(nn.Module):\n    def __init__(self, embed_size, num_layers, heads, forward_expansion, dropout):\n        super().__init__()\n        self.layers = nn.ModuleList([\n            TransformerBlock(embed_size, heads, forward_expansion, dropout)\n            for _ in range(num_layers)\n        ])\n        self.norm = nn.LayerNorm(embed_size)\n    \n    def forward(self, x, enc_out, src_mask, trg_mask):\n        for layer in self.layers:\n            x = layer(x, enc_out, enc_out, src_mask)\n        return self.norm(x)\n`})}),`\n`,(0,n.jsx)(e.h2,{children:\"Positional Encoding\"}),`\n`,(0,n.jsx)(e.p,{children:\"Since transformers process all positions simultaneously, positional encoding provides sequence order information:\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-python\",children:`class PositionalEncoding(nn.Module):\n    def __init__(self, d_model, max_len=5000):\n        super().__init__()\n        pe = torch.zeros(max_len, d_model)\n        position = torch.arange(0, max_len, dtype=torch.float).unsqueeze(1)\n        div_term = torch.exp(\n            torch.arange(0, d_model, 2).float() * (-math.log(10000.0) / d_model)\n        )\n        pe[:, 0::2] = torch.sin(position * div_term)\n        pe[:, 1::2] = torch.cos(position * div_term)\n        pe = pe.unsqueeze(0).transpose(0, 1)\n        self.register_buffer(\"pe\", pe)\n    \n    def forward(self, x):\n        return x + self.pe[:x.size(0), :]\n`})}),`\n`,(0,n.jsx)(e.h2,{children:\"Why Transformers Won\"}),`\n`,(0,n.jsxs)(e.ol,{children:[`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"Parallelization\"}),\": Unlike RNNs, transformers process all positions simultaneously\"]}),`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"Long-range Dependencies\"}),\": Attention mechanism captures relationships across the entire sequence\"]}),`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"Scalability\"}),\": Performance improves predictably with more data and compute\"]}),`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"Transfer Learning\"}),\": Pre-trained transformers fine-tune well to downstream tasks\"]}),`\n`]}),`\n`,(0,n.jsx)(e.h2,{children:\"Impact\"}),`\n`,(0,n.jsx)(e.p,{children:\"Transformers have enabled:\"}),`\n`,(0,n.jsxs)(e.ul,{children:[`\n`,(0,n.jsx)(e.li,{children:\"Large language models (GPT, BERT, Llama)\"}),`\n`,(0,n.jsx)(e.li,{children:\"Vision transformers (ViT)\"}),`\n`,(0,n.jsx)(e.li,{children:\"Multimodal models (CLIP, DALL-E)\"}),`\n`,(0,n.jsx)(e.li,{children:\"Speech models (Whisper)\"}),`\n`,(0,n.jsx)(e.li,{children:\"Code models (Codex, CodeLlama)\"}),`\n`]})]})}function c(r={}){let{wrapper:e}=r.components||{};return e?(0,n.jsx)(e,{...r,children:(0,n.jsx)(h,{...r})}):h(r)}return k(q);})();\n;return Component;"