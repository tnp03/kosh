"var Component=(()=>{var u=Object.create;var i=Object.defineProperty;var m=Object.getOwnPropertyDescriptor;var _=Object.getOwnPropertyNames;var p=Object.getPrototypeOf,f=Object.prototype.hasOwnProperty;var g=(t,e)=>()=>(e||t((e={exports:{}}).exports,e),e.exports),y=(t,e)=>{for(var r in e)i(t,r,{get:e[r],enumerable:!0})},l=(t,e,r,s)=>{if(e&&typeof e==\"object\"||typeof e==\"function\")for(let o of _(e))!f.call(t,o)&&o!==r&&i(t,o,{get:()=>e[o],enumerable:!(s=m(e,o))||s.enumerable});return t};var w=(t,e,r)=>(r=t!=null?u(p(t)):{},l(e||!t||!t.__esModule?i(r,\"default\",{value:t,enumerable:!0}):r,t)),k=t=>l(i({},\"__esModule\",{value:!0}),t);var d=g((x,a)=>{a.exports=_jsx_runtime});var b={};y(b,{default:()=>h});var n=w(d());function c(t){let e={a:\"a\",br:\"br\",code:\"code\",h1:\"h1\",h2:\"h2\",h3:\"h3\",li:\"li\",ol:\"ol\",p:\"p\",pre:\"pre\",strong:\"strong\",ul:\"ul\",...t.components};return(0,n.jsxs)(n.Fragment,{children:[(0,n.jsx)(e.h1,{children:\"Attention Is All You Need\"}),`\n`,(0,n.jsxs)(e.p,{children:[(0,n.jsx)(e.strong,{children:\"Authors\"}),\": Vaswani, Shazeer, Parmar, Uszkoreit, Jones, Gomez, Kaiser, Polosukhin\",(0,n.jsx)(e.br,{}),`\n`,(0,n.jsx)(e.strong,{children:\"Published\"}),\": NeurIPS 2017\",(0,n.jsx)(e.br,{}),`\n`,(0,n.jsx)(e.strong,{children:\"arXiv\"}),\": \",(0,n.jsx)(e.a,{href:\"https://arxiv.org/abs/1706.03762\",children:\"1706.03762\"})]}),`\n`,(0,n.jsx)(e.h2,{children:\"Abstract\"}),`\n`,(0,n.jsx)(e.p,{children:\"The dominant sequence transduction models are based on complex recurrent or convolutional neural networks that include an encoder and a decoder. The best models also connect the encoder and decoder through an attention mechanism. We propose a new simple network architecture, the Transformer, based solely on attention mechanisms, dispensing with recurrence and convolutions entirely.\"}),`\n`,(0,n.jsx)(e.h2,{children:\"The Problem\"}),`\n`,(0,n.jsx)(e.p,{children:\"Before transformers, sequence modeling relied on:\"}),`\n`,(0,n.jsxs)(e.ol,{children:[`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"RNNs\"}),\": Process sequences step-by-step, losing parallelization\"]}),`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"LSTMs/GRUs\"}),\": Improved memory but still sequential\"]}),`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"CNNs\"}),\": Parallel but limited in capturing long-range dependencies\"]}),`\n`]}),`\n`,(0,n.jsxs)(e.p,{children:[\"The key challenge was \",(0,n.jsx)(e.strong,{children:\"computational efficiency\"}),\" while maintaining the ability to model long-range dependencies.\"]}),`\n`,(0,n.jsx)(e.h2,{children:\"The Solution: Self-Attention\"}),`\n`,(0,n.jsx)(e.p,{children:\"The transformer replaces recurrence with self-attention, which allows the model to weigh the importance of different parts of the input:\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-python\",children:`import torch\nimport torch.nn as nn\nimport math\n\ndef scaled_dot_product_attention(query, key, value, mask=None):\n    d_k = query.size(-1)\n    scores = torch.matmul(query, key.transpose(-2, -1)) / math.sqrt(d_k)\n    \n    if mask is not None:\n        scores = scores.masked_fill(mask == 0, -1e9)\n    \n    attention_weights = torch.softmax(scores, dim=-1)\n    output = torch.matmul(attention_weights, value)\n    \n    return output, attention_weights\n`})}),`\n`,(0,n.jsx)(e.h2,{children:\"Key Components\"}),`\n`,(0,n.jsx)(e.h3,{children:\"Multi-Head Attention\"}),`\n`,(0,n.jsx)(e.p,{children:\"Multiple attention heads allow the model to focus on different aspects:\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-python\",children:`class MultiHeadAttention(nn.Module):\n    def __init__(self, d_model, num_heads):\n        super().__init__()\n        self.d_model = d_model\n        self.num_heads = num_heads\n        self.d_k = d_model // num_heads\n        \n        self.W_q = nn.Linear(d_model, d_model)\n        self.W_k = nn.Linear(d_model, d_model)\n        self.W_v = nn.Linear(d_model, d_model)\n        self.W_o = nn.Linear(d_model, d_model)\n    \n    def forward(self, query, key, value, mask=None):\n        batch_size = query.size(0)\n        \n        # Linear projections and reshape\n        Q = self.W_q(query).view(batch_size, -1, self.num_heads, self.d_k).transpose(1, 2)\n        K = self.W_k(key).view(batch_size, -1, self.num_heads, self.d_k).transpose(1, 2)\n        V = self.W_v(value).view(batch_size, -1, self.num_heads, self.d_k).transpose(1, 2)\n        \n        # Apply attention\n        attention_output, attention_weights = scaled_dot_product_attention(Q, K, V, mask)\n        \n        # Concatenate heads and project\n        attention_output = attention_output.transpose(1, 2).contiguous().view(\n            batch_size, -1, self.d_model\n        )\n        \n        return self.W_o(attention_output)\n`})}),`\n`,(0,n.jsx)(e.h3,{children:\"Position-wise Feed-Forward Networks\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-python\",children:`class FeedForward(nn.Module):\n    def __init__(self, d_model, d_ff, dropout=0.1):\n        super().__init__()\n        self.linear1 = nn.Linear(d_model, d_ff)\n        self.linear2 = nn.Linear(d_ff, d_model)\n        self.dropout = nn.Dropout(dropout)\n        self.relu = nn.ReLU()\n    \n    def forward(self, x):\n        return self.linear2(self.dropout(self.relu(self.linear1(x))))\n`})}),`\n`,(0,n.jsx)(e.h3,{children:\"Positional Encoding\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-python\",children:`class PositionalEncoding(nn.Module):\n    def __init__(self, d_model, max_len=5000, dropout=0.1):\n        super().__init__()\n        self.dropout = nn.Dropout(dropout)\n        \n        pe = torch.zeros(max_len, d_model)\n        position = torch.arange(0, max_len, dtype=torch.float).unsqueeze(1)\n        div_term = torch.exp(\n            torch.arange(0, d_model, 2).float() * (-math.log(10000.0) / d_model)\n        )\n        pe[:, 0::2] = torch.sin(position * div_term)\n        pe[:, 1::2] = torch.cos(position * div_term)\n        pe = pe.unsqueeze(0).transpose(0, 1)\n        \n        self.register_buffer(\"pe\", pe)\n    \n    def forward(self, x):\n        x = x + self.pe[:x.size(0), :]\n        return self.dropout(x)\n`})}),`\n`,(0,n.jsx)(e.h2,{children:\"Results\"}),`\n`,(0,n.jsx)(e.p,{children:\"The transformer achieved state-of-the-art results on machine translation:\"}),`\n`,(0,n.jsxs)(e.ul,{children:[`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"WMT 2014 English-German\"}),\": 28.4 BLEU (previous best: 27.3)\"]}),`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"WMT 2014 English-French\"}),\": 41.0 BLEU (previous best: 40.5)\"]}),`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"Training time\"}),\": 3.5 days on 8 GPUs (vs. weeks for RNN models)\"]}),`\n`]}),`\n`,(0,n.jsx)(e.h2,{children:\"Impact\"}),`\n`,(0,n.jsx)(e.p,{children:\"This paper fundamentally changed AI:\"}),`\n`,(0,n.jsxs)(e.ol,{children:[`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"Foundation for LLMs\"}),\": GPT, BERT, Llama, and all modern LLMs are transformers\"]}),`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"Beyond NLP\"}),\": Vision transformers (ViT), speech transformers, code transformers\"]}),`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"Scalability\"}),\": Enabled the scaling laws that led to GPT-3, GPT-4\"]}),`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"Efficiency\"}),\": Parallelization made large-scale training feasible\"]}),`\n`]}),`\n`,(0,n.jsx)(e.h2,{children:\"Citation\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-bibtex\",children:`@inproceedings{vaswani2017attention,\n  title={Attention is all you need},\n  author={Vaswani, Ashish and Shazeer, Noam and Parmar, Niki and Uszkoreit, Jakob and Jones, Llion and Gomez, Aidan N and Kaiser, {\\\\L}ukasz and Polosukhin, Illia},\n  booktitle={Advances in neural information processing systems},\n  volume={30},\n  year={2017}\n}\n`})})]})}function h(t={}){let{wrapper:e}=t.components||{};return e?(0,n.jsx)(e,{...t,children:(0,n.jsx)(c,{...t})}):c(t)}return k(b);})();\n;return Component;"